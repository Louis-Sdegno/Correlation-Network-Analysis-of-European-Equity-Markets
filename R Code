# Minimum Spanning Tree based on Mantegna distance

distance_matrix <- sqrt(2 * (1 - corr_matrix))

dist_graph <- igraph::graph_from_adjacency_matrix(
  distance_matrix,
  mode = "undirected",
  weighted = TRUE,
  diag = FALSE
)

mst_graph <- mst(dist_graph, weights = E(dist_graph)$weight)

mst_plot <- ggraph(mst_graph, layout = "fr") +
  geom_edge_link(aes(width = 1 / weight), alpha = 0.7) +
  geom_node_point(size = 6) +
  geom_node_text(aes(label = name), repel = TRUE, size = 4) +
  theme_void() +
  labs(title = "Minimum Spanning Tree of European Equity Assets")

mst_plot

ggsave("minimum_spanning_tree.png", mst_plot, width = 10, height = 8, dpi = 300)

#STEP 11
# Rolling average correlation

window_size <- 252   # approximately one trading year
step_size <- 21      # approximately one trading month

returns_matrix <- returns_wide %>%
  select(-date) %>%
  as.matrix()

dates <- returns_wide$date

rolling_results <- data.frame()

for (start in seq(1, nrow(returns_matrix) - window_size, by = step_size)) {
  
  end <- start + window_size - 1
  
  window_returns <- returns_matrix[start:end, ]
  window_corr <- cor(window_returns, use = "pairwise.complete.obs")
  
  upper_corr <- window_corr[upper.tri(window_corr)]
  
  avg_corr <- mean(upper_corr, na.rm = TRUE)
  
  rolling_results <- rbind(
    rolling_results,
    data.frame(
      date = dates[end],
      average_correlation = avg_corr
    )
  )
}

rolling_corr_plot <- ggplot(rolling_results, aes(x = date, y = average_correlation)) +
  geom_line(linewidth = 1) +
  geom_vline(xintercept = as.Date("2020-03-01"), linetype = "dashed") +
  geom_vline(xintercept = as.Date("2022-02-24"), linetype = "dashed") +
  theme_minimal() +
  labs(
    title = "Rolling Average Correlation",
    x = "Date",
    y = "Average pairwise correlation"
  )

rolling_corr_plot

ggsave("rolling_average_correlation.png", rolling_corr_plot, width = 10, height = 6, dpi = 300)

write.csv(rolling_results, "rolling_average_correlation.csv", row.names = FALSE)

#STEP 12
# Rolling network density with threshold 0.70

threshold <- 0.70

rolling_density_results <- data.frame()

for (start in seq(1, nrow(returns_matrix) - window_size, by = step_size)) {
  
  end <- start + window_size - 1
  
  window_returns <- returns_matrix[start:end, ]
  window_corr <- cor(window_returns, use = "pairwise.complete.obs")
  
  adj_window <- window_corr
  adj_window[adj_window < threshold] <- 0
  diag(adj_window) <- 0
  
  g_window <- igraph::graph_from_adjacency_matrix(
    adj_window,
    mode = "undirected",
    weighted = TRUE,
    diag = FALSE
  )
  
  rolling_density_results <- rbind(
    rolling_density_results,
    data.frame(
      date = dates[end],
      edges = ecount(g_window),
      density = edge_density(g_window)
    )
  )
}

rolling_density_plot <- ggplot(rolling_density_results, aes(x = date, y = density)) +
  geom_line(linewidth = 1) +
  geom_vline(xintercept = as.Date("2020-03-01"), linetype = "dashed") +
  geom_vline(xintercept = as.Date("2022-02-24"), linetype = "dashed") +
  theme_minimal() +
  labs(
    title = "Rolling Network Density, threshold = 0.70",
    x = "Date",
    y = "Network density"
  )

rolling_density_plot

ggsave("rolling_network_density.png", rolling_density_plot, width = 10, height = 6, dpi = 300)

write.csv(rolling_density_results, "rolling_network_density.csv", row.names = FALSE)

