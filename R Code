rolling_combined <- rolling_results %>%
  left_join(rolling_density_results, by = "date") %>%
  mutate(
    regime = case_when(
      date < as.Date("2020-01-01") ~ "2018-2019",
      date >= as.Date("2020-01-01") & date < as.Date("2022-01-01") ~ "2020-2021",
      date >= as.Date("2022-01-01") & date < as.Date("2023-01-01") ~ "2022",
      date >= as.Date("2023-01-01") ~ "2023-2024"
    )
  )

regime_summary <- rolling_combined %>%
  group_by(regime) %>%
  summarise(
    avg_correlation = mean(average_correlation, na.rm = TRUE),
    avg_density = mean(density, na.rm = TRUE),
    avg_edges = mean(edges, na.rm = TRUE)
  )

