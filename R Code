#STEP 1
library(tidyquant)
library(tidyverse)

tickers <- c("^GDAXI", "^FCHI", "FTSEMIB.MI", "^IBEX", "^FTSE",
             "EXV1.DE", "EXH1.DE", "EXV3.DE", "EXV4.DE",
             "EXH4.DE", "EXH3.DE", "EXH9.DE", "EXV5.DE")

prices <- tq_get(tickers,
                 from = "2018-01-01",
                 to = "2024-12-31",
                 get = "stock.prices")

prices %>%
  group_by(symbol) %>%
  summarise(
    first_date = min(date),
    last_date = max(date),
    n_obs = n()
  )

#STEP2
asset_labels <- c(
  "^GDAXI" = "DAX",
  "^FCHI" = "CAC 40",
  "FTSEMIB.MI" = "FTSE MIB",
  "^IBEX" = "IBEX 35",
  "^FTSE" = "FTSE 100",
  "EXV1.DE" = "Banks",
  "EXH1.DE" = "Energy",
  "EXV3.DE" = "Technology",
  "EXV4.DE" = "Healthcare",
  "EXH4.DE" = "Industrials",
  "EXH3.DE" = "Food & Beverage",
  "EXH9.DE" = "Utilities",
  "EXV5.DE" = "Automobiles"
)

#STEP3
returns <- prices %>%
  group_by(symbol) %>%
  arrange(date) %>%
  mutate(log_return = log(adjusted) - log(lag(adjusted))) %>%
  select(date, symbol, log_return) %>%
  drop_na()

returns_wide <- returns %>%
  pivot_wider(names_from = symbol, values_from = log_return) %>%
  drop_na()

# Rename columns with readable asset names
colnames(returns_wide)[-1] <- asset_labels[colnames(returns_wide)[-1]]

head(returns_wide)
dim(returns_wide)

#STEP4
skewness_fun <- function(x) {
  mean((x - mean(x, na.rm = TRUE))^3, na.rm = TRUE) / sd(x, na.rm = TRUE)^3
}

kurtosis_fun <- function(x) {
  mean((x - mean(x, na.rm = TRUE))^4, na.rm = TRUE) / sd(x, na.rm = TRUE)^4
}

descriptive_stats <- returns_wide %>%
  select(-date) %>%
  summarise(across(
    everything(),
    list(
      mean = ~ mean(.x, na.rm = TRUE),
      sd = ~ sd(.x, na.rm = TRUE),
      min = ~ min(.x, na.rm = TRUE),
      max = ~ max(.x, na.rm = TRUE),
      skewness = ~ skewness_fun(.x),
      kurtosis = ~ kurtosis_fun(.x)
    )
  )) %>%
  pivot_longer(
    cols = everything(),
    names_to = c("asset", ".value"),
    names_pattern = "(.*)_(mean|sd|min|max|skewness|kurtosis)"
  )

descriptive_stats
write.csv(descriptive_stats, "descriptive_stats.csv", row.names = FALSE)

#STEP5
corr_matrix <- returns_wide %>%
  select(-date) %>%
  cor(use = "pairwise.complete.obs")

round(corr_matrix, 2)

#STEP6
corr_long <- as.data.frame(as.table(corr_matrix))
colnames(corr_long) <- c("Asset1", "Asset2", "Correlation")

heatmap_plot <- ggplot(corr_long, aes(x = Asset1, y = Asset2, fill = Correlation)) +
  geom_tile() +
